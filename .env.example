PORT=3000
# Primary storage: Astra DB (leave LOCAL_DEV unset). Optional local JSON fallback:
# LOCAL_DEV=1
# If Astra fails with queryA ECONNREFUSED on Windows, the server sets public DNS by default.
# Override with comma-separated resolvers:
# DNS_SERVERS=8.8.8.8,1.1.1.1

ASTRA_DB_ID=571e1f93-bd40-4d6b-9c3b-15d50a972439
ASTRA_DB_KEYSPACE=hacklab
ASTRA_DB_APPLICATION_TOKEN=YOUR_ASTRA_APPLICATION_TOKEN
ASTRA_DB_SECURE_BUNDLE_PATH=secure-connect-hack-lab.zip

# Production (GitHub Pages build) — set in GitHub Actions secrets, not here:
# HACKLAB_API_URL=https://hacklab-api.onrender.com
# HACKLAB_PAGES_BASE=/davhacklab
